<script>
  const bar=document.getElementById("bar");
  addEventListener("scroll",()=>{
    const h=document.documentElement;
    bar.style.width=(h.scrollTop/(h.scrollHeight-h.clientHeight)*100)+"%";
  },{passive:true});

  const io=new IntersectionObserver(es=>{
    es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target);}});
  },{threshold:.13,rootMargin:"0px 0px -5% 0px"});
  document.querySelectorAll(".rev").forEach(el=>io.observe(el));

  const rail=[...document.querySelectorAll("#rail a")];
  const secs=rail.map(a=>document.querySelector(a.getAttribute("href")));
  function updateRail(){
    const sy=window.scrollY;
    let active=secs[0];
    for(const s of secs){if(s&&s.offsetTop-80<=sy)active=s;}
    if(active){const id="#"+active.id;rail.forEach(a=>a.classList.toggle("on",a.getAttribute("href")===id));}
  }
  addEventListener("scroll",updateRail,{passive:true});
  updateRail();
</script>
